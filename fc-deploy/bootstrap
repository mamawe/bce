#!/bin/bash
# BCE 自定义运行时启动脚本（离线依赖版）
cd /code

# 将预置依赖加入 PYTHONPATH
export PYTHONPATH=/code/lib:$PYTHONPATH

# 复制数据库到可写目录 /tmp
cp bce.db /tmp/bce.db 2>/dev/null

# 环境变量
export BCE_DB_PATH=/tmp/bce.db
export BCE_ENV=production

# 启动 FastAPI
exec python3 -m uvicorn app.main:app --host 0.0.0.0 --port 9000
